{
	"name": "parse",
	"version": "0.4.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
	"scripts": {
		"build": "vite build",
		"deploy": "pnpm run build && wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest",
		"test:e2e": "playwright test",
		"cf-typegen": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply parse-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply parse-db --remote",
		"sync:android": "pnpm run build && cap sync android",
		"open:android": "pnpm run sync:android && cap open android",
		"generate-assets": "node generate_icons.js && capacitor-assets generate --android"
	},
	"devDependencies": {
		"@capacitor/assets": "^3.0.5",
		"@cloudflare/vitest-pool-workers": "^0.18.8",
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.1.1",
		"@types/service-worker-mock": "^2.0.4",
		"sharp": "^0.35.3",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vitest": "~4.1.10",
		"wrangler": "^4.114.0"
	},
	"dependencies": {
		"@capacitor-community/text-to-speech": "^8.0.2",
		"@capacitor/android": "^8.4.2",
		"@capacitor/app": "^8.1.1",
		"@capacitor/browser": "^8.0.4",
		"@capacitor/cli": "^8.4.2",
		"@capacitor/core": "^8.4.2",
		"@capacitor/preferences": "^8.0.1",
		"@capawesome/capacitor-background-task": "^8.0.2",
		"@cloudflare/puppeteer": "^1.1.0",
		"@mozilla/readability": "^0.6.0",
		"@oslojs/encoding": "^1.1.0",
		"arctic": "^3.7.0",
		"defuddle": "^0.19.2",
		"dompurify": "^3.4.12",
		"hono": "^4.12.32",
		"linkedom": "^0.18.13",
		"postal-mime": "^2.7.5"
	}
}
