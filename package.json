{
	"name": "parse",
	"version": "0.4.3",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
	"scripts": {
		"build": "vite build",
		"deploy": "pnpm run build && wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest",
		"test:e2e": "playwright test",
		"cf-typegen": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply parse-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply parse-db --remote",
		"sync:android": "pnpm run build && cap sync android",
		"open:android": "pnpm run sync:android && cap open android",
		"generate-assets": "node generate_icons.js && capacitor-assets generate --android"
	},
	"devDependencies": {
		"@capacitor/assets": "^3.0.5",
		"@cloudflare/vitest-pool-workers": "^0.21.3",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.5.1",
		"@types/service-worker-mock": "^2.0.4",
		"sharp": "^0.35.4",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "~4.1.11",
		"wrangler": "^4.131.1"
	},
	"dependencies": {
		"@capacitor-community/text-to-speech": "^8.0.2",
		"@capacitor/android": "^8.5.2",
		"@capacitor/app": "^8.1.1",
		"@capacitor/browser": "^8.0.4",
		"@capacitor/cli": "^8.5.2",
		"@capacitor/core": "^8.5.2",
		"@capacitor/preferences": "^8.0.1",
		"@capawesome/capacitor-background-task": "^8.0.3",
		"@cloudflare/puppeteer": "^1.4.0",
		"@mozilla/readability": "^0.6.0",
		"@oslojs/encoding": "^1.1.0",
		"arctic": "^3.7.0",
		"defuddle": "^0.19.3",
		"dompurify": "^3.4.15",
		"hono": "^4.13.7",
		"linkedom": "^0.18.13",
		"postal-mime": "^3.0.0"
	}
}
