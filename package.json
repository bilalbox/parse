{
  "name": "parse",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "vite build",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply parse-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply parse-db --remote",
    "sync:android": "pnpm run build && cap sync android",
    "open:android": "pnpm run sync:android && cap open android",
    "generate-assets": "node generate_icons.js && capacitor-assets generate --android"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.68.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/dompurify": "^3.2.0",
    "@types/mozilla-readability": "^0.2.1",
    "@types/node": "^26.0.1",
    "@types/service-worker-mock": "^2.0.4",
    "sharp": "^0.35.2",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "~4.1.9",
    "wrangler": "^4.105.0"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capawesome/capacitor-background-task": "^8.0.2",
    "@cloudflare/puppeteer": "^1.1.0",
    "@mozilla/readability": "^0.6.0",
    "@oslojs/encoding": "^1.1.0",
    "arctic": "^3.7.0",
    "dompurify": "^3.4.11",
    "hono": "^4.12.27",
    "linkedom": "^0.18.12",
    "oslo": "^1.2.1",
    "postal-mime": "^2.7.5"
  }
}
