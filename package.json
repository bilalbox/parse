{
	"name": "parse",
	"version": "0.8.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.8.2+sha512.a5941679663d952c5f0ecc38ba98af98b4dc01b95780354f6894f2f873973cef2f7e2989d7db3ee5393938ae21f62fe06bcdf685d475ddad829a62095d2b8b11",
	"scripts": {
		"build": "vite build",
		"deploy": "pnpm run build && wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest",
		"test:e2e": "playwright test",
		"cf-typegen": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply parse-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply parse-db --remote",
		"sync:android": "pnpm run build && cap sync android",
		"open:android": "pnpm run sync:android && cap open android",
		"generate-assets": "node generate_icons.js && capacitor-assets generate --android"
	},
	"devDependencies": {
		"@capacitor/assets": "^3.0.5",
		"@cloudflare/vitest-plugin": "^1.4.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.4",
		"@types/service-worker-mock": "^2.0.4",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "~5.0.3",
		"wrangler": "^4.149.0"
	},
	"dependencies": {
		"@capacitor-community/text-to-speech": "^8.0.2",
		"@capacitor/android": "^8.5.3",
		"@capacitor/app": "^8.1.2",
		"@capacitor/browser": "^8.0.5",
		"@capacitor/cli": "^8.5.3",
		"@capacitor/core": "^8.5.3",
		"@capacitor/preferences": "^8.0.1",
		"@capawesome/capacitor-background-task": "^8.0.3",
		"@cloudflare/puppeteer": "^1.4.0",
		"@mozilla/readability": "^0.6.0",
		"@oslojs/encoding": "^1.1.0",
		"arctic": "^3.7.0",
		"defuddle": "^0.19.4",
		"dompurify": "^3.4.16",
		"hono": "^4.13.13",
		"linkedom": "^0.18.13",
		"postal-mime": "^4.0.5"
	}
}
