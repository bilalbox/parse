{
  "name": "parse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "vite build",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "cf-typegen": "wrangler types",
    "sync:android": "pnpm run build && cap sync android",
    "open:android": "pnpm run sync:android && cap open android",
    "generate-assets": "node generate_icons.js && capacitor-assets generate --android"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.66.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/mozilla-readability": "^0.2.1",
    "@types/node": "^25.9.4",
    "@types/service-worker-mock": "^2.0.4",
    "sharp": "^0.35.2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "~4.1.9",
    "wrangler": "^4.103.0"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@cloudflare/puppeteer": "^1.1.0",
    "@mozilla/readability": "^0.6.0",
    "hono": "^4.12.26",
    "linkedom": "^0.18.12",
    "postal-mime": "^2.7.4"
  }
}
