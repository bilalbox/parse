{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"module": "es2022",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"types": [
			"node",
			"$app/types"
		],
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"exclude": ["test", "src/service-worker.ts", "src/service-worker"],
	"include": [
		"worker-configuration.d.ts",
		"src/**/*.ts",
		"src/**/*.svelte"
	]
}
